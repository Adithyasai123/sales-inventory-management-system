# ==============================================================================
# SALES & INVENTORY MANAGEMENT SYSTEM (SIMS) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development | production | testing)
ENVIRONMENT=development

# Database Configuration (MySQL 8 InnoDB, TiDB Cloud Serverless, or SQLite)
DATABASE_URL=mysql+pymysql://sims_user:sims_password@localhost:3306/sims_db
# For TiDB Cloud Serverless (Free Managed MySQL 8.0):
# DATABASE_URL=mysql+pymysql://<userPrefix>.root:<password>@<gateway-host>:4000/sims_db
# For Docker Compose, use:
# DATABASE_URL=mysql+pymysql://sims_user:sims_password@mysql:3306/sims_db
# For zero-config local testing:
# DATABASE_URL=sqlite:///./sims.db

# JWT Security Secrets (Must be random, unique 256-bit strings in production)
JWT_SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
JWT_REFRESH_SECRET_KEY=87b9201f114c0a52f9543e33fbe4d9b23a54b38d381014e7811dc31f8b4d89e2
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:80

# SMTP / Mailpit Configuration
SMTP_HOST=localhost
# In Docker Compose, use: SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SSL=false
EMAILS_FROM_EMAIL=noreply@sims.local
EMAILS_FROM_NAME=SIMS Notifications

# Business Rules Default Threshold
DEFAULT_APPROVAL_THRESHOLD=1000.00

# Frontend Configuration
VITE_API_URL=
